# Compiler API configuration. Copy to .env for local development only.
# The API fails fast on invalid values; see src/config.ts for the validation.

# Runtime
NODE_ENV=development
PORT=8080
# In production, CORS_ORIGIN must be set and TRUST_PROXY_HOPS must be >= 1.

# CORS: exact origins, comma-separated. No wildcards. HTTPS required in prod.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Railway proxies one hop. Set 0 only for direct local exposure.
TRUST_PROXY_HOPS=0

# Request body limit (512kb or 8mb syntax, hard max 16mb)
BODY_LIMIT=8mb

# Rate limits (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_BUILD_MAX=6
RATE_LIMIT_DEPLOY_MAX=15
RATE_LIMIT_AIRDROP_MAX=5
RATE_LIMIT_WRITE_MAX=60

# Hourly per-IP quotas on the two expensive endpoints
QUOTA_WINDOW_MS=3600000
BUILD_QUOTA_MAX=60
DEPLOY_QUOTA_MAX=10

# Build execution
MAX_CONCURRENT_BUILDS=2
MAX_CONCURRENT_OPS=3
BUILD_TIMEOUT_MS=180000
BUILD_WORK_DIR=/workspaces/build
BUILD_CACHE_DIR=/var/lib/solphg/cache
TOOLCHAIN_TAG=anchor-0.31.1-agave-2.2.7-rust-1.86.0

# RPC endpoints (must be https://). Never accept these from request bodies.
DEVNET_RPC_URL=https://api.devnet.solana.com
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Faucet: hex-encoded 64-byte ed25519 secret, or set FAUCET_ADDRESS only.
# WARNING: never commit a real key. Provide this via a secret manager in prod.
# FAUCET_SECRET_KEY=
# FAUCET_ADDRESS=
FAUCET_STATE_FILE=/tmp/solphg-faucet-state.json
FAUCET_MAX_SOL_PER_REQUEST=2
FAUCET_DAILY_CAP_SOL=50
FAUCET_COOLDOWN_SECONDS=3600

# Optional admin bootstrap endpoint (leave unset to disable)
# ADMIN_TOKEN=

# Optional local validator for CPI debug / CU profiling (disabled by default)
ENABLE_LOCAL_VALIDATOR=false
